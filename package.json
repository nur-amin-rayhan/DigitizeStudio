{
  "name": "digitizestudio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DigitizeStudio - Cyber-HUD Digital Marketing Agency Monorepo (Frontend, CMS, Dashboard, WhatsApp CRM)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:cms": "npm run dev --workspace=cms",
    "dev:dashboard": "npm run dev --workspace=dashboard",
    "dev:whatsapp-crm": "npm run dev --workspace=whatsapp-crm",
    "build:frontend": "npm run build --workspace=frontend",
    "build:cms": "npm run build --workspace=cms",
    "build:dashboard": "npm run build --workspace=dashboard",
    "build:whatsapp-crm": "npm run build --workspace=whatsapp-crm",
    "build": "npm run build --workspaces --if-present",
    "start:frontend": "npm run start --workspace=frontend",
    "start:cms": "npm run start --workspace=cms",
    "start:dashboard": "npm run start --workspace=dashboard",
    "start:whatsapp-crm": "npm run start --workspace=whatsapp-crm",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "typescript": "^5.6.3"
  }
}
